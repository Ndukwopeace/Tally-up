# -----------------------------------------------------------------------------
# Environment variables for Tally-Up. NAMES ONLY: never put real values here.
#
# Copy to `.env.local` for local development (git-ignored, SEC-3).
# On Vercel, the Supabase integration creates these for you; the build accepts
# the names it uses (see tooling/supabase-public-env.ts and docs/SETUP.md).
# -----------------------------------------------------------------------------

# Supabase project URL (https://<project>.supabase.co).
# Also accepted: NEXT_PUBLIC_SUPABASE_URL, SUPABASE_URL.
VITE_SUPABASE_URL=

# Supabase PUBLIC key (anon / publishable). Safe in the browser because RLS protects the data.
# Also accepted: VITE_SUPABASE_PUBLISHABLE_KEY, NEXT_PUBLIC_SUPABASE_ANON_KEY,
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, SUPABASE_ANON_KEY, SUPABASE_PUBLISHABLE_KEY.
# The build stops if a secret key is put here.
VITE_SUPABASE_ANON_KEY=

# Local development only: `mock` uses fictional users and no network
# (README "Local development"). Ignored by deployed builds.
VITE_DATA_SOURCE=

# Local development with the mock only: the password every mock account uses.
# Choose any value; it protects nothing real.
VITE_MOCK_PASSWORD=
